{
  "name": "gitsense",
  "displayName": "GitSense",
  "publisher": "KAMAL-02",
  "icon": "images/icon.png",
  "description": "Automates the process of summarizing your coding activity and committing it to a GitHub repository",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitsense.summarizeNow",
        "title": "Summarize and Push Now",
        "category": "GitSense"
      },
      {
        "command": "gitsense.signIn",
        "title": "Sign in with GitHub",
        "category": "GitSense"
      },
      {
        "command": "gitsense.showLog",
        "title": "Show Log",
        "category": "GitSense"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KAMAL-02/GitSense.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
